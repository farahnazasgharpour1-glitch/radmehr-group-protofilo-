    "eslint": "10.14.0",
    "globals": "17.14.0",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0"
  },
  "overrides": {
    "basic-ftp": "6.2.1",
    "minimatch": "11.0.3"
  }
